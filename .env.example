# ================================
# 🤖 Authentication Configuration
# ================================

# Found on the page to your Trakt Application (https://trakt.tv/oauth/applications)
TRAKT_CLIENT_ID=

# Found on the page to your Trakt Application (https://trakt.tv/oauth/applications)
TRAKT_CLIENT_SECRET=

# Discord uses the application name as the Rich Presence activity
# (e.g. "Watching Inception"). Two apps let movies and series use different names.

# Preferred: two Discord applications (https://discord.com/developers/applications)
MOVIE_DISCORD_CLIENT_ID=
SERIES_DISCORD_CLIENT_ID=

# Fallback: one Discord application for both movies and series.
# Used only when MOVIE_DISCORD_CLIENT_ID / SERIES_DISCORD_CLIENT_ID are unset.
DISCORD_CLIENT_ID=

# TMDB API (Free) to enable artwork in rich presence (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=
